# Janus server configuration file (KEY=VALUE).
#
# Point the server at this file with:  JANUS_CONFIG_FILE=/path/to/janus-server.env
# Resolution order is:  environment variable  >  this file  >  built-in default.
#
# Keys are identical to the environment variables; the values below are the built-in
# defaults (see server/internal/config Default* constants). Lines beginning with '#'
# are comments; surrounding quotes and an optional 'export ' prefix are tolerated.
# Keep secrets here only if the file is access-restricted (e.g. chmod 600); prefer the
# *_FILE variants or real environment variables for secret material.

# --- Core (REQUIRED: the command signing key has no default; server refuses to start) ---
# JANUS_COMMAND_SIGNING_KEY=            # 32-byte hex (openssl rand -hex 32) — or use the _FILE form:
# JANUS_COMMAND_SIGNING_KEY_FILE=/etc/janus/command-signing.key
# JANUS_JWT_SECRET=                     # session-token key; defaults to the command key (or _FILE form)
JANUS_DATABASE_URL=postgres://janus:janus@localhost:5432/janus?sslmode=disable
JANUS_GRPC_ADDR=127.0.0.1:9443
JANUS_HTTP_ADDR=127.0.0.1:8080
JANUS_LOG_LEVEL=info

# --- TLS / mTLS (gRPC) ---
# JANUS_TLS_CERT_FILE=
# JANUS_TLS_KEY_FILE=
# JANUS_CLIENT_CA_FILE=
JANUS_REQUIRE_TLS=false
JANUS_REQUIRE_MTLS=false

# --- Auth / dashboard ---
JANUS_DISABLE_AUTH=false
JANUS_CORS_ORIGIN=http://localhost:5173
# Global per-client-IP REST rate limit (OPS-002); 0 disables. Auth endpoints keep 20/min.
# Behind a shared reverse proxy all clients appear as the proxy IP — raise or disable.
# JANUS_API_RATE_LIMIT_PER_MIN=600

# --- Operator notifications for critical findings (OPS-003) — all optional ---
# Slack incoming webhook:
# JANUS_NOTIFY_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# Email (all three required to enable the email channel):
# JANUS_NOTIFY_SMTP_ADDR=smtp.example.com:587
# JANUS_NOTIFY_SMTP_FROM=janus@example.com
# JANUS_NOTIFY_SMTP_TO=soc@example.com,ops@example.com
# JANUS_NOTIFY_SMTP_USERNAME=
# JANUS_NOTIFY_SMTP_PASSWORD=
# PagerDuty Events API v2 routing key:
# JANUS_NOTIFY_PAGERDUTY_ROUTING_KEY=
# Minimum severity (1-5) that triggers a notification (default 5 = critical only):
# JANUS_NOTIFY_MIN_SEVERITY=5
# Per-role logins (or the *_PASSWORD_HASH bcrypt form); no compiled-in defaults:
# JANUS_ADMIN_PASSWORD=
# JANUS_OPERATOR_PASSWORD=
# JANUS_VIEWER_PASSWORD=
# Optional per-role username override (defaults to the role name):
# JANUS_ADMIN_USERNAME=admin
# Multi-tenancy (WP-020): the tenant a login's data is scoped to (defaults to 'default').
# All reads, the migration write path, and WebSocket events are filtered by this tenant.
# Manage tenants via the admin API (GET/POST /api/tenants); map agents with
# `janus-server agent enroll --tenant <id>`.
# JANUS_ADMIN_TENANT=default
# JANUS_OPERATOR_TENANT=default
# JANUS_VIEWER_TENANT=default

# --- Per-agent authentication (WP-029 P1) ---
# JANUS_AGENT_AUTH_MODE=shared          # 'shared' (legacy single-key agent token) or 'per-agent'
# JANUS_AGENT_KEY_MASTER=               # required for per-agent mode (derives per-agent keys) — or _FILE form:
# JANUS_AGENT_KEY_MASTER_FILE=/etc/janus/agent-key-master
# JANUS_AGENT_AUTH_WINDOW_SECONDS=300   # per-agent request-token freshness window

# --- Database pool ---
JANUS_DB_MAX_CONNS=25
JANUS_DB_MIN_CONNS=5
JANUS_DB_MAX_CONN_LIFETIME=30m
JANUS_DB_MAX_CONN_IDLE_TIME=5m

# --- Operations ---
JANUS_AGENT_STALL_SECONDS=300
JANUS_GRPC_MAX_RECV_BYTES=33554432
JANUS_GRACEFUL_SHUTDOWN_SECONDS=30
# JANUS_METRICS_ADDR=                   # serve /metrics on a dedicated listener
# JANUS_METRICS_TOKEN=                  # require this bearer token on /metrics when set

# --- HSM backend (key custody; default 'software' = in-process real ML-DSA via circl) ---
JANUS_HSM_MODE=software                 # disabled | software | pkcs11
# JANUS_HSM_MODULE_PATH=                 # PKCS#11 module (.so/.dll) — required for pkcs11
# JANUS_HSM_TOKEN_LABEL=                 # select the slot by token label (highest priority)
# JANUS_HSM_SLOT_INDEX=                  # 0-based slot position from `janus-server hsm info`
# JANUS_HSM_SLOT=0                       # token slot id (used when no label/index is set)
# JANUS_HSM_PIN=                         # user PIN (prefer the _FILE form below)
# JANUS_HSM_PIN_FILE=/etc/janus/hsm.pin
JANUS_HSM_SIGN_COMMANDS=false           # hold the HMAC command key in the HSM
JANUS_HSM_COMMAND_KEY_LABEL=janus-command-signing

# --- Command signing scheme (HMAC baseline is always on; ml-dsa ADDS an asymmetric layer) ---
JANUS_COMMAND_SIG_SCHEME=hmac           # hmac | ml-dsa
JANUS_COMMAND_SIG_ALG=ML-DSA-65         # ML-DSA parameter set (ml-dsa scheme)
JANUS_COMMAND_SIG_KEY_LABEL=janus-command-mldsa  # HSM object label for the ML-DSA key
# JANUS_COMMAND_SIG_KEY_FILE=           # software ML-DSA key (stable fingerprint w/o an HSM); see `pki command-ca`
# JANUS_COMMAND_SIG_CERT_FILE=          # leaf command cert → CA-chained janus-sig-v2 (WP-029 P3)

# --- LLM provider (optional; leaving JANUS_LLM_BASE_URL unset disables all LLM features) ---
# JANUS_LLM_BASE_URL=
# JANUS_LLM_API_KEY_FILE=
# JANUS_LLM_API_KEY_ENV=JANUS_LLM_API_KEY
# JANUS_LLM_CAPABILITY_MODE=analysis_only
# JANUS_LLM_MODEL_ANALYSIS=gpt-4o-mini
# JANUS_LLM_MODEL_REMEDIATION=gpt-4o
# JANUS_LLM_TIMEOUT_SECONDS=30
# JANUS_LLM_MAX_RETRIES=2
# JANUS_LLM_MAX_CONCURRENT=4
# JANUS_LLM_MAX_TOKENS_PER_REQUEST=0    # 0 = no per-call output cap
# JANUS_LLM_MAX_REQUESTS_PER_MINUTE=0   # 0 = no rate guard
