# Janus Agent — portable deployment settings (Windows).
# Edit the values below, then run  .\run.ps1
# On first run these are rendered into janus-agent.toml.

# Controller gRPC endpoint (telemetry stream).
JANUS_CONTROLLER_ENDPOINT="http://127.0.0.1:9443"

# Controller HTTP endpoint (heartbeat / fleet config).
JANUS_HTTP_CONTROLLER_ENDPOINT="http://127.0.0.1:8080"

# 32-byte hex HMAC key shared with the server. REQUIRED — the agent will not
# start without it. Generate with:  openssl rand -hex 32
JANUS_COMMAND_SIGNING_KEY=""

# Directories to scan, as a TOML array literal. Backslashes must be escaped.
JANUS_SCAN_ROOTS='["C:\\Program Files", "C:\\inetpub"]'

# Where the agent keeps its state (SQLite queue, host-id, reports, backups).
# Relative paths resolve inside the bundle directory.
JANUS_STATE_DIR="state"

# Agent log verbosity: error | warn | info | debug | trace
RUST_LOG="info"
