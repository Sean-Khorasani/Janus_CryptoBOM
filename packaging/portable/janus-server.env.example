# Janus Server — portable deployment settings.
# Edit the values below, then run ./run.sh.

# 32-byte hex key for JWT + HMAC signing. REQUIRED — server refuses to start
# without it. Generate with:  openssl rand -hex 32
JANUS_COMMAND_SIGNING_KEY=""

# PostgreSQL connection string. The server runs schema migrations on startup.
JANUS_DATABASE_URL="postgres://janus:janus@127.0.0.1:5432/janus?sslmode=disable"

# Listen addresses.
JANUS_HTTP_ADDR="127.0.0.1:8080"
JANUS_GRPC_ADDR="127.0.0.1:9443"

# Origin the dashboard is served from (CORS). Match where you host ./ui.
JANUS_CORS_ORIGIN="http://127.0.0.1:5173"

# Dashboard logins — no compiled-in defaults. Set a password per role you need
# (or a bcrypt hash via JANUS_<ROLE>_PASSWORD_HASH). Until one is set, login is
# disabled (fail closed).
# JANUS_ADMIN_PASSWORD="change-me"
# JANUS_OPERATOR_PASSWORD="change-me"

# Structured log level: debug | info | warn | error
JANUS_LOG_LEVEL="info"

# Graceful-shutdown drain window in seconds (OPS-001), clamped 1–300.
JANUS_GRACEFUL_SHUTDOWN_SECONDS="30"
